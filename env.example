# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Admin Panel ───────────────────────────────────────────────────────────────
# The Google account email that is allowed to access /admin.
# Server-only (no NEXT_PUBLIC_ prefix) — checked inside API routes so it is
# never bundled into client-side JavaScript and never trusted as a client
# check on its own.
# If this is not set the admin API will refuse ALL logins (no hardcoded fallback).
# Example: ADMIN_EMAIL=you@gmail.com
ADMIN_EMAIL=
# ── Service Worker / Build ────────────────────────────────────────────────────
# Set this to a unique string on every production deployment so the PWA service
# worker re-registers and clears stale caches. Use your CI build ID or timestamp.
# In Vercel you can set this to $VERCEL_GIT_COMMIT_SHA.
# If unset in development it falls back to a timestamp (which is fine locally
# but causes spurious SW re-registrations on every hot-reload).
# Example: NEXT_PUBLIC_BUILD_ID=abc123
NEXT_PUBLIC_BUILD_ID=

# ── Instructions ──────────────────────────────────────────────────────────────
# 1. Copy this file to .env.local:   cp env.example .env.local
# 2. Fill in your Supabase credentials above
# 3. Never commit .env.local to git
#
# ── IMPORTANT: Supabase OAuth Redirect URL setup ─────────────────────────────
# In your Supabase dashboard:
#   Authentication → URL Configuration → Redirect URLs
#   Add ALL of these (your actual production/preview URLs):
#
#     https://your-app.vercel.app/auth/callback
#     https://your-custom-domain.com/auth/callback  (if you have one)
#
#   Site URL (also in URL Configuration):
#     https://your-app.vercel.app
#
# The app uses PKCE flow — it will NEVER redirect to localhost.
# The redirect URL is always built from window.location.origin at runtime.

# ── Razorpay (Payment Integration) ───────────────────────────────────────────
# Get these from https://dashboard.razorpay.com → Settings → API Keys
# Test mode keys start with rzp_test_, live mode keys start with rzp_live_
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ── Supabase Service Role (for server-side API routes only) ──────────────────
# Get from Supabase → Settings → API → service_role key
# NEVER expose this in client code or NEXT_PUBLIC_ vars
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Razorpay Setup Steps ──────────────────────────────────────────────────────
# 1. Create account at razorpay.com
# 2. Go to Settings → API Keys → Generate Key
# 3. Add RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET to Vercel environment variables
# 4. Add SUPABASE_SERVICE_ROLE_KEY to Vercel environment variables
# 5. Create two Plans (Subscriptions → Plans) — ₹240/monthly, ₹2500/yearly —
#    and put their plan_xxx IDs into src/lib/pricing.ts (PRICING.monthly.planId
#    and PRICING.yearly.planId) — this is the only file pricing/plan IDs live in.
# 6. Set up the webhook below (REQUIRED, not optional — without it, renewals
#    never update the database and access never actually extends or lapses).

# ── Razorpay Subscriptions (recurring billing) ───────────────────────────────
# Settings → Webhooks → Add New Webhook in Razorpay Dashboard:
#   URL:    https://your-app.vercel.app/api/razorpay/webhook
#   Secret: must match RAZORPAY_WEBHOOK_SECRET below exactly
#   Events: subscription.activated, subscription.charged,
#           subscription.cancelled, subscription.completed,
#           subscription.halted
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── Daily expiry-reminder cron job ───────────────────────────────────────────
# Vercel Cron (configured in vercel.json) calls /api/cron/subscription-reminders
# once a day and sends this as a Bearer token. Generate your own value with:
#   openssl rand -hex 32
CRON_SECRET=

# ── Push Notifications (Web Push — admin AND regular users) ─────────────────
# Lets the admin get alerted on new signups/subscriptions/tickets, and lets
# any user opt in to "your trial/subscription ends in 3 days" reminders.
# These VAPID keys are this app's own push identity — not a Supabase or
# Razorpay credential. Generate your own pair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Any mailto: address — required by the Web Push spec for abuse-contact
# purposes only, never shown to users.
VAPID_SUBJECT=mailto:you@example.com

# Shared secret between Supabase DB Webhooks and this app — prevents anyone
# else from POSTing fake "new user" / "new ticket" events to your webhook
# routes. Generate your own with: openssl rand -hex 32
WEBHOOK_SECRET=

# ── Push Notification Setup Steps ────────────────────────────────────────────
# 1. Run supabase_recurring_billing_and_push.sql and
#    supabase_webhook_idempotency.sql in Supabase → SQL Editor
# 2. Add VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT, WEBHOOK_SECRET,
#    RAZORPAY_WEBHOOK_SECRET, CRON_SECRET to Vercel → Settings → Environment
#    Variables, then redeploy
# 3. Open /admin → Info tab → enable push for admin alerts
# 4. Regular users enable their own reminders from /profile ("Turn on" under
#    Expiry Reminders — only appears once they're on a trial or paid plan)
# 5. In Supabase Dashboard → Database → Webhooks → create:
#      Table: users (schema: auth) · Event: Insert
#      URL:   https://your-app.vercel.app/api/webhooks/new-user
#      Header: x-webhook-secret = <same value as WEBHOOK_SECRET>
# 6. Repeat for a second webhook:
#      Table: support_tickets (schema: public) · Event: Insert
#      URL:   https://your-app.vercel.app/api/webhooks/new-ticket
#      Header: x-webhook-secret = <same value as WEBHOOK_SECRET>

# ── Error Logging (Sentry) — OPTIONAL, app works fine without it ────────────
# Without these set, errors just go to console.error (visible in Vercel's
# function logs only briefly). With these set, every server AND client
# error gets captured permanently and searchably in Sentry's dashboard.
# 1. Create a free account at sentry.io → create a Next.js project
# 2. Copy the DSN it gives you into BOTH vars below (same value, two names
#    because one must be server-only and one must be client-bundleable)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional — only needed if you want Sentry to upload source maps at build
# time for cleaner stack traces. Get these from Sentry → Settings → Auth
# Tokens. Safe to leave blank; build just skips source map upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Email Notifications (Resend) — OPTIONAL, app works fine without it ──────
# Without these set, sendEmail() silently no-ops (logs a warning, sends
# nothing) — signups/payments/trial-ending still work, users just won't
# get an email on top of the push notification.
# 1. Create a free account at resend.com
# 2. Verify a sending domain (Resend → Domains) — you cannot send real
#    email to real users from their shared test domain, only to your own
#    verified-account email during testing
# 3. Create an API key (Resend → API Keys)
RESEND_API_KEY=
# Must be an address on the domain you verified in step 2, e.g.
# "Construction Manager <notifications@yourdomain.com>"
EMAIL_FROM=

# ── Site URL (used for metadata, sitemap, robots.txt) ────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

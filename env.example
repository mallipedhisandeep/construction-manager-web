# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Instructions ──────────────────────────────────────────────────────────────
# 1. Copy this file to .env.local:   cp env.example .env.local
# 2. Fill in your Supabase credentials above
# 3. Never commit .env.local to git
#
# ── IMPORTANT: Supabase OAuth Redirect URL setup ─────────────────────────────
# In your Supabase dashboard:
#   Authentication → URL Configuration → Redirect URLs
#   Add ALL of these (your actual production/preview URLs):
#
#     https://your-app.vercel.app/auth/callback
#     https://your-custom-domain.com/auth/callback  (if you have one)
#
#   Site URL (also in URL Configuration):
#     https://your-app.vercel.app
#
# The app uses PKCE flow — it will NEVER redirect to localhost.
# The redirect URL is always built from window.location.origin at runtime.
